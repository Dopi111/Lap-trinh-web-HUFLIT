@model IEnumerable<FiveGuys.Models.HeroBanner>

@{
    ViewBag.Title = "Quản Lý Hero Banners";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto|Varela+Round">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <style>
        body { margin-top: 20px; }
        .table-wrapper { background: #fff; padding: 20px 25px; border-radius: 3px; box-shadow: 0 1px 1px rgba(0,0,0,.05); }
        .table-title { padding-bottom: 15px; background: #435d7d; color: #fff; padding: 16px 30px; margin: -20px -25px 10px; border-radius: 3px 3px 0 0; }
        .table-title h2 { margin: 5px 0 0; font-size: 24px; }
        .table-title .btn { color: #fff; float: right; font-size: 13px; border: none; min-width: 50px; border-radius: 2px; margin-left: 10px; }
        .banner-thumb { max-width: 120px; max-height: 80px; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="table-wrapper">
            <div class="table-title">
                <div class="row">
                    <div class="col-sm-6">
                        <h2>Quản Lý <b>Hero Banners</b></h2>
                    </div>
                    <div class="col-sm-6">
                        <a href="@Url.Action("Create")" class="btn btn-success">
                            <i class="fa fa-plus"></i> <span>Thêm Banner Mới</span>
                        </a>
                    </div>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["SuccessMessage"]
                </div>
            }

            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Banner</th>
                        <th>Tiêu đề</th>
                        <th>Vị trí</th>
                        <th>Thứ tự</th>
                        <th>Trạng thái</th>
                        <th>Thời gian</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    <img src="@item.ImagePath" alt="@item.Title" class="banner-thumb img-thumbnail" />
                                </td>
                                <td>
                                    <strong>@item.Title</strong><br />
                                    <small class="text-muted">@item.Subtitle</small>
                                </td>
                                <td><span class="badge badge-info">@item.BannerPosition</span></td>
                                <td>@item.DisplayOrder</td>
                                <td>
                                    @if (item.IsCurrentlyActive)
                                    {
                                        <span class="label label-success">Đang hoạt động</span>
                                    }
                                    else if (item.IsActive)
                                    {
                                        <span class="label label-warning">Đã lên lịch</span>
                                    }
                                    else
                                    {
                                        <span class="label label-default">Tạm ngưng</span>
                                    }
                                </td>
                                <td>
                                    @if (item.StartDate.HasValue)
                                    {
                                        <small>Từ: @item.StartDate.Value.ToString("dd/MM/yyyy")</small><br />
                                    }
                                    @if (item.EndDate.HasValue)
                                    {
                                        <small>Đến: @item.EndDate.Value.ToString("dd/MM/yyyy")</small>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning btn-xs">
                                        <i class="fa fa-pencil"></i> Sửa
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger btn-xs">
                                        <i class="fa fa-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center">
                                <p class="text-muted">Chưa có banner nào.</p>
                                <a href="@Url.Action("Create")" class="btn btn-primary">Thêm banner đầu tiên</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
