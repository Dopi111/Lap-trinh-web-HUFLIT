@model IEnumerable<FiveGuys.Models.HeroBanner>

@{
    ViewBag.Title = "Quản Lý Hero Banners";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FiveGuys</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        .glass-effect { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); }
        .hover-lift:hover { transform: translateY(-4px); transition: all 0.3s; }
    </style>
</head>
<body class="bg-gradient-to-br from-purple-50 via-pink-50 to-rose-50 min-h-screen">

    <div class="bg-white shadow-lg border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl flex items-center justify-center shadow-lg">
                        <i class="fas fa-palette text-white text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
                            Quản Lý Hero Banners
                        </h1>
                        <p class="text-sm text-gray-600 mt-1">Quản lý banner hiển thị trên trang web</p>
                    </div>
                </div>
                <a href="@Url.Action("Create")"
                   class="group flex items-center space-x-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white px-6 py-3 rounded-xl hover:from-purple-700 hover:to-pink-700 transform hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl">
                    <i class="fas fa-plus-circle group-hover:rotate-90 transition-transform duration-300"></i>
                    <span class="font-semibold">Thêm Banner</span>
                </a>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6">
                <div class="bg-green-50 border-l-4 border-green-500 rounded-lg p-4 shadow-md">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle text-green-500 text-xl mr-3"></i>
                        <p class="text-green-800 font-medium">@TempData["SuccessMessage"]</p>
                    </div>
                </div>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="space-y-6">
                @foreach (var item in Model)
                {
                    <div class="glass-effect rounded-2xl overflow-hidden shadow-lg hover-lift group">
                        <div class="grid md:grid-cols-3 gap-6 p-6">
                            <!-- Banner Preview -->
                            <div class="md:col-span-1">
                                <div class="relative aspect-video bg-gray-100 rounded-xl overflow-hidden">
                                    <img src="@item.ImagePath" alt="@item.Title" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                    <div class="absolute top-3 right-3">
                                        @if (item.IsCurrentlyActive)
                                        {
                                            <span class="px-3 py-1 bg-green-500 text-white text-xs font-bold rounded-full shadow-lg animate-pulse">
                                                <i class="fas fa-circle text-[8px] mr-1"></i>Đang hiển thị
                                            </span>
                                        }
                                        else if (item.IsActive)
                                        {
                                            <span class="px-3 py-1 bg-yellow-500 text-white text-xs font-bold rounded-full shadow-lg">
                                                <i class="far fa-clock text-[8px] mr-1"></i>Đã lên lịch
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-3 py-1 bg-gray-400 text-white text-xs font-bold rounded-full shadow-lg">
                                                <i class="fas fa-pause text-[8px] mr-1"></i>Tạm ngưng
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Banner Info -->
                            <div class="md:col-span-2">
                                <div class="flex items-start justify-between mb-4">
                                    <div>
                                        <h3 class="text-2xl font-bold text-gray-800 mb-2">@item.Title</h3>
                                        <p class="text-lg text-gray-600 mb-2">@item.Subtitle</p>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <p class="text-sm text-gray-500">@item.Description</p>
                                        }
                                    </div>
                                    <span class="px-3 py-1 bg-gradient-to-r from-purple-500 to-pink-500 text-white text-xs font-bold rounded-full">
                                        @item.BannerPosition
                                    </span>
                                </div>

                                <div class="grid grid-cols-2 gap-4 mb-4 text-sm">
                                    @if (!string.IsNullOrEmpty(item.ButtonText))
                                    {
                                        <div class="flex items-center text-gray-600">
                                            <i class="fas fa-mouse-pointer w-5 text-blue-500"></i>
                                            <span>Button: <strong>@item.ButtonText</strong></span>
                                        </div>
                                    }
                                    <div class="flex items-center text-gray-600">
                                        <i class="fas fa-sort-numeric-up w-5 text-indigo-500"></i>
                                        <span>Thứ tự: <strong>@item.DisplayOrder</strong></span>
                                    </div>
                                    @if (item.StartDate.HasValue)
                                    {
                                        <div class="flex items-center text-gray-600">
                                            <i class="fas fa-calendar-alt w-5 text-green-500"></i>
                                            <span>Từ: <strong>@item.StartDate.Value.ToString("dd/MM/yyyy")</strong></span>
                                        </div>
                                    }
                                    @if (item.EndDate.HasValue)
                                    {
                                        <div class="flex items-center text-gray-600">
                                            <i class="fas fa-calendar-check w-5 text-red-500"></i>
                                            <span>Đến: <strong>@item.EndDate.Value.ToString("dd/MM/yyyy")</strong></span>
                                        </div>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
                                    <a href="@Url.Action("Edit", new { id = item.Id })"
                                       class="flex items-center space-x-2 bg-amber-50 hover:bg-amber-100 text-amber-600 px-4 py-2.5 rounded-xl transition-all duration-300">
                                        <i class="fas fa-edit"></i>
                                        <span class="text-sm font-medium">Chỉnh sửa</span>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })"
                                       class="flex items-center space-x-2 bg-red-50 hover:bg-red-100 text-red-600 px-4 py-2.5 rounded-xl transition-all duration-300">
                                        <i class="fas fa-trash"></i>
                                        <span class="text-sm font-medium">Xóa</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="glass-effect rounded-2xl shadow-xl p-16 text-center">
                <div class="w-32 h-32 bg-gradient-to-br from-purple-100 to-pink-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-palette text-6xl text-purple-400"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-3">Chưa có banner nào</h3>
                <p class="text-gray-600 mb-8 max-w-md mx-auto">
                    Tạo banner đầu tiên để hiển thị trên trang web
                </p>
                <a href="@Url.Action("Create")"
                   class="inline-flex items-center space-x-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white px-8 py-4 rounded-xl hover:from-purple-700 hover:to-pink-700 transform hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl">
                    <i class="fas fa-plus-circle text-xl"></i>
                    <span class="font-semibold text-lg">Thêm banner đầu tiên</span>
                </a>
            </div>
        }

    </div>

</body>
</html>
