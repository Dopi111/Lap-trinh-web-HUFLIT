@model FiveGuys.Models.MediaImage

@{
    ViewBag.Title = "Thêm Hình Ảnh Mới";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FiveGuys</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        .glass-effect {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .drag-active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            transform: scale(1.02);
        }
        @@keyframes shimmer {
            0% { background-position: -1000px 0; }
            100% { background-position: 1000px 0; }
        }
        .shimmer {
            animation: shimmer 2s infinite linear;
            background: linear-gradient(to right, #f6f7f8 0%, #edeef1 20%, #f6f7f8 40%, #f6f7f8 100%);
            background-size: 1000px 100%;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 min-h-screen">

    <!-- Header -->
    <div class="bg-white shadow-lg border-b border-gray-200">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex items-center space-x-4">
                <a href="@Url.Action("Index")"
                   class="w-10 h-10 bg-gray-100 hover:bg-gray-200 rounded-xl flex items-center justify-center transition-all duration-300 group">
                    <i class="fas fa-arrow-left text-gray-600 group-hover:-translate-x-1 transition-transform"></i>
                </a>
                <div>
                    <h1 class="text-3xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
                        Thêm Hình Ảnh Mới
                    </h1>
                    <p class="text-sm text-gray-600 mt-1">Upload hình ảnh mới vào hệ thống</p>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        @using (Html.BeginForm("Create", "MediaImages", FormMethod.Post, new { enctype = "multipart/form-data", id = "uploadForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="space-y-6">

                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 shadow-md animate-shake">
                        <div class="flex items-start">
                            <i class="fas fa-exclamation-circle text-red-500 text-xl mr-3 mt-0.5"></i>
                            <div>
                                <h3 class="text-red-800 font-semibold mb-2">Có lỗi xảy ra:</h3>
                                @Html.ValidationSummary(true, "", new { @class = "text-red-700 text-sm space-y-1" })
                            </div>
                        </div>
                    </div>
                }

                <!-- Image Upload Section -->
                <div class="glass-effect rounded-2xl shadow-xl p-8">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center">
                        <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-indigo-500 rounded-lg flex items-center justify-center mr-3">
                            <i class="fas fa-cloud-upload-alt text-white text-sm"></i>
                        </div>
                        Upload Hình Ảnh
                    </h2>

                    <!-- Drag & Drop Zone -->
                    <div id="dropZone"
                         class="relative border-3 border-dashed border-gray-300 rounded-2xl p-12 text-center transition-all duration-300 cursor-pointer hover:border-blue-500 hover:bg-blue-50/50 group">
                        <input type="file"
                               name="imageFile"
                               id="imageFile"
                               accept="image/*"
                               required
                               class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />

                        <div id="uploadPrompt" class="pointer-events-none">
                            <div class="w-20 h-20 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-cloud-upload-alt text-4xl text-blue-500"></i>
                            </div>
                            <p class="text-lg font-semibold text-gray-700 mb-2">
                                Kéo thả hình ảnh vào đây hoặc click để chọn
                            </p>
                            <p class="text-sm text-gray-500">
                                Hỗ trợ: JPG, JPEG, PNG, GIF, WEBP, SVG • Tối đa 5MB
                            </p>
                        </div>

                        <!-- Preview Container -->
                        <div id="imagePreviewContainer" class="hidden pointer-events-none">
                            <img id="imagePreview" class="max-w-full max-h-96 rounded-xl shadow-lg mx-auto" />
                            <p id="fileName" class="mt-4 text-sm font-medium text-gray-700"></p>
                            <p id="fileSize" class="text-xs text-gray-500"></p>
                            <button type="button"
                                    id="removeImage"
                                    class="mt-4 px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors pointer-events-auto">
                                <i class="fas fa-times mr-2"></i>Xóa và chọn lại
                            </button>
                        </div>
                    </div>

                    @Html.ValidationMessageFor(model => model.ImagePath, "", new { @class = "text-red-500 text-sm mt-2 block" })
                </div>

                <!-- Image Information -->
                <div class="glass-effect rounded-2xl shadow-xl p-8">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center">
                        <div class="w-8 h-8 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg flex items-center justify-center mr-3">
                            <i class="fas fa-info-circle text-white text-sm"></i>
                        </div>
                        Thông Tin Hình Ảnh
                    </h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Image Name -->
                        <div class="md:col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Tên hình ảnh <span class="text-red-500">*</span>
                            </label>
                            @Html.EditorFor(model => model.ImageName, new {
                                htmlAttributes = new {
                                    @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-300",
                                    placeholder = "Nhập tên mô tả cho hình ảnh"
                                }
                            })
                            @Html.ValidationMessageFor(model => model.ImageName, "", new { @class = "text-red-500 text-sm mt-1 block" })
                        </div>

                        <!-- Image Type -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Loại hình ảnh <span class="text-red-500">*</span>
                            </label>
                            @Html.DropDownListFor(model => model.ImageType, (SelectList)ViewBag.ImageTypeList,
                                "-- Chọn loại hình ảnh --",
                                new { @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-300 bg-white" })
                            @Html.ValidationMessageFor(model => model.ImageType, "", new { @class = "text-red-500 text-sm mt-1 block" })
                        </div>

                        <!-- Display Order -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Thứ tự hiển thị
                            </label>
                            @Html.EditorFor(model => model.DisplayOrder, new {
                                htmlAttributes = new {
                                    @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-300",
                                    type = "number",
                                    value = "0"
                                }
                            })
                        </div>

                        <!-- Description -->
                        <div class="md:col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Mô tả
                            </label>
                            @Html.TextAreaFor(model => model.Description, new {
                                @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-300 resize-none",
                                rows = 4,
                                placeholder = "Nhập mô tả chi tiết cho hình ảnh..."
                            })
                        </div>

                        <!-- Dimensions -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Chiều rộng (px)
                            </label>
                            @Html.EditorFor(model => model.Width, new {
                                htmlAttributes = new {
                                    @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-300",
                                    type = "number",
                                    placeholder = "VD: 1920"
                                }
                            })
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Chiều cao (px)
                            </label>
                            @Html.EditorFor(model => model.Height, new {
                                htmlAttributes = new {
                                    @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-300",
                                    type = "number",
                                    placeholder = "VD: 1080"
                                }
                            })
                        </div>

                        <!-- Created By -->
                        <div class="md:col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Người tạo
                            </label>
                            @Html.EditorFor(model => model.CreatedBy, new {
                                htmlAttributes = new {
                                    @class = "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-300",
                                    placeholder = "Nhập tên người tạo"
                                }
                            })
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="glass-effect rounded-2xl shadow-xl p-6">
                    <div class="flex items-center justify-between gap-4">
                        <a href="@Url.Action("Index")"
                           class="flex items-center space-x-2 px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl transition-all duration-300 font-semibold">
                            <i class="fas fa-times"></i>
                            <span>Hủy bỏ</span>
                        </a>

                        <button type="submit"
                                id="submitBtn"
                                class="flex items-center space-x-2 px-8 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white rounded-xl transition-all duration-300 font-semibold shadow-lg hover:shadow-xl transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fas fa-save"></i>
                            <span>Lưu hình ảnh</span>
                        </button>
                    </div>
                </div>

            </div>
        }

    </div>

    <script>
        // Drag & Drop Functionality
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('imageFile');
        const uploadPrompt = document.getElementById('uploadPrompt');
        const previewContainer = document.getElementById('imagePreviewContainer');
        const preview = document.getElementById('imagePreview');
        const fileName = document.getElementById('fileName');
        const fileSize = document.getElementById('fileSize');
        const removeBtn = document.getElementById('removeImage');
        const submitBtn = document.getElementById('submitBtn');

        // Prevent default drag behaviors
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, preventDefaults, false);
            document.body.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        // Highlight drop zone when item is dragged over it
        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => {
                dropZone.classList.add('drag-active', 'border-blue-500', 'bg-blue-50');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => {
                dropZone.classList.remove('drag-active', 'border-blue-500', 'bg-blue-50');
            }, false);
        });

        // Handle dropped files
        dropZone.addEventListener('drop', (e) => {
            const dt = e.dataTransfer;
            const files = dt.files;
            fileInput.files = files;
            handleFiles(files);
        }, false);

        // Handle file selection
        fileInput.addEventListener('change', (e) => {
            handleFiles(e.target.files);
        });

        function handleFiles(files) {
            if (files.length === 0) return;

            const file = files[0];

            // Validate file type
            const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp', 'image/svg+xml'];
            if (!validTypes.includes(file.type)) {
                alert('❌ Chỉ chấp nhận file ảnh: JPG, JPEG, PNG, GIF, WEBP, SVG');
                fileInput.value = '';
                return;
            }

            // Validate file size (5MB)
            if (file.size > 5 * 1024 * 1024) {
                alert('❌ Kích thước file không được vượt quá 5MB');
                fileInput.value = '';
                return;
            }

            // Show preview
            const reader = new FileReader();
            reader.onload = (e) => {
                preview.src = e.target.result;
                fileName.textContent = file.name;
                fileSize.textContent = `Kích thước: ${(file.size / 1024).toFixed(2)} KB`;

                uploadPrompt.classList.add('hidden');
                previewContainer.classList.remove('hidden');
                previewContainer.classList.add('animate-fade-in');
            };
            reader.readAsDataURL(file);
        }

        // Remove image
        removeBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            fileInput.value = '';
            preview.src = '';
            uploadPrompt.classList.remove('hidden');
            previewContainer.classList.add('hidden');
        });

        // Form submission with loading state
        document.getElementById('uploadForm').addEventListener('submit', function() {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i><span>Đang xử lý...</span>';
        });
    </script>

</body>
</html>
