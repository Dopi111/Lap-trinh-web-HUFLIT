@model FiveGuys.Models.MediaImage

@{
    ViewBag.Title = "Xóa Hình Ảnh";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FiveGuys</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-gradient-to-br from-red-50 via-orange-50 to-yellow-50 min-h-screen">

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">
            <!-- Warning Header -->
            <div class="bg-gradient-to-r from-red-600 to-orange-600 px-8 py-6">
                <div class="flex items-center space-x-4 text-white">
                    <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center animate-pulse">
                        <i class="fas fa-exclamation-triangle text-3xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold">Xác Nhận Xóa</h1>
                        <p class="text-red-100">Hành động này không thể hoàn tác!</p>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div class="p-8">
                <div class="bg-yellow-50 border-l-4 border-yellow-500 rounded-lg p-6 mb-8">
                    <div class="flex items-start">
                        <i class="fas fa-info-circle text-yellow-600 text-xl mr-3 mt-0.5"></i>
                        <p class="text-yellow-800 font-medium">
                            Bạn có chắc chắn muốn xóa hình ảnh này? File sẽ bị xóa vĩnh viễn khỏi hệ thống.
                        </p>
                    </div>
                </div>

                <!-- Image Preview -->
                <div class="bg-gray-50 rounded-2xl p-6 mb-6">
                    <div class="flex items-start gap-6">
                        <img src="@Model.FullImageUrl" alt="@Model.ImageName" class="w-64 h-48 object-cover rounded-xl shadow-lg" />
                        <div class="flex-1">
                            <h3 class="text-xl font-bold text-gray-800 mb-4">@Model.ImageName</h3>
                            <div class="space-y-2 text-sm">
                                <p class="text-gray-600"><i class="fas fa-tag w-5 text-blue-500"></i> <strong>Loại:</strong> @Model.ImageType</p>
                                <p class="text-gray-600"><i class="fas fa-image w-5 text-indigo-500"></i> <strong>Đường dẫn:</strong> @Model.ImagePath</p>
                                @if (!string.IsNullOrEmpty(Model.Description))
                                {
                                    <p class="text-gray-600"><i class="fas fa-file-alt w-5 text-purple-500"></i> <strong>Mô tả:</strong> @Model.Description</p>
                                }
                                @if (Model.FileSize.HasValue)
                                {
                                    <p class="text-gray-600"><i class="fas fa-database w-5 text-green-500"></i> <strong>Kích thước:</strong> @((Model.FileSize / 1024).ToString("N0")) KB</p>
                                }
                                @if (Model.Width.HasValue && Model.Height.HasValue)
                                {
                                    <p class="text-gray-600"><i class="fas fa-expand w-5 text-pink-500"></i> <strong>Kích thước:</strong> @Model.Width × @Model.Height px</p>
                                }
                                <p class="text-gray-600"><i class="far fa-calendar w-5 text-orange-500"></i> <strong>Ngày tạo:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="flex items-center gap-4">
                        <a href="@Url.Action("Index")" class="flex-1 flex items-center justify-center space-x-2 px-6 py-4 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl transition-all duration-300 font-semibold">
                            <i class="fas fa-arrow-left"></i>
                            <span>Hủy bỏ</span>
                        </a>
                        <button type="submit" class="flex-1 flex items-center justify-center space-x-2 px-6 py-4 bg-gradient-to-r from-red-600 to-orange-600 hover:from-red-700 hover:to-orange-700 text-white rounded-xl transition-all duration-300 font-semibold shadow-lg hover:shadow-xl transform hover:scale-105">
                            <i class="fas fa-trash-alt"></i>
                            <span>Xác nhận xóa</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

</body>
</html>
