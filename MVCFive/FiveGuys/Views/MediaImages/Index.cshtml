@model IEnumerable<FiveGuys.Models.MediaImage>

@{
    ViewBag.Title = "Quản Lý Hình Ảnh";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto|Varela+Round">
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <style>
        body { margin-top: 20px; }
        .table-wrapper { background: #fff; padding: 20px 25px; border-radius: 3px; box-shadow: 0 1px 1px rgba(0,0,0,.05); }
        .table-title { padding-bottom: 15px; background: #435d7d; color: #fff; padding: 16px 30px; margin: -20px -25px 10px; border-radius: 3px 3px 0 0; }
        .table-title h2 { margin: 5px 0 0; font-size: 24px; }
        .table-title .btn { color: #fff; float: right; font-size: 13px; border: none; min-width: 50px; border-radius: 2px; border: none; outline: none !important; margin-left: 10px; }
        .table-title .btn i { float: left; font-size: 21px; margin-right: 5px; }
        .table-title .btn span { float: left; margin-top: 2px; }
        .img-thumbnail { max-width: 80px; max-height: 80px; }
        .badge { padding: 5px 10px; }
        .filter-form { margin-bottom: 20px; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="table-wrapper">
            <div class="table-title">
                <div class="row">
                    <div class="col-sm-6">
                        <h2>Quản Lý <b>Hình Ảnh</b></h2>
                    </div>
                    <div class="col-sm-6">
                        <a href="@Url.Action("Create")" class="btn btn-success">
                            <i class="material-icons">&#xE147;</i> <span>Thêm Hình Ảnh Mới</span>
                        </a>
                    </div>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["ErrorMessage"]
                </div>
            }

            <!-- Filter -->
            <div class="filter-form">
                <form method="get" class="form-inline">
                    <div class="form-group">
                        <label>Lọc theo loại:</label>
                        <select name="imageType" class="form-control" onchange="this.form.submit()">
                            <option value="">Tất cả</option>
                            @if (ViewBag.ImageTypes != null)
                            {
                                foreach (var type in ViewBag.ImageTypes)
                                {
                                    <option value="@type" @(Request.QueryString["imageType"] == type ? "selected" : "")>@type</option>
                                }
                            }
                        </select>
                    </div>
                </form>
            </div>

            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Hình ảnh</th>
                        <th>Tên hình ảnh</th>
                        <th>Loại</th>
                        <th>Kích thước</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    <img src="@item.FullImageUrl" alt="@item.ImageName" class="img-thumbnail" />
                                </td>
                                <td>
                                    <strong>@item.ImageName</strong><br />
                                    <small class="text-muted">@item.Description</small>
                                </td>
                                <td>
                                    <span class="badge badge-info">@item.ImageType</span>
                                </td>
                                <td>
                                    @if (item.FileSize.HasValue)
                                    {
                                        <text>@((item.FileSize / 1024).ToString("N0")) KB</text>
                                    }
                                    @if (item.Width.HasValue && item.Height.HasValue)
                                    {
                                        <br /><small class="text-muted">@item.Width x @item.Height px</small>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="label label-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="label label-default">Tạm ngưng</span>
                                    }
                                </td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-info btn-xs" title="Chi tiết">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning btn-xs" title="Sửa">
                                        <i class="fa fa-pencil"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger btn-xs" title="Xóa">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center">
                                <p class="text-muted">Chưa có hình ảnh nào.</p>
                                <a href="@Url.Action("Create")" class="btn btn-primary">Thêm hình ảnh đầu tiên</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="clearfix">
                <div class="hint-text">
                    Hiển thị <b>@(Model?.Count() ?? 0)</b> hình ảnh
                </div>
            </div>
        </div>
    </div>
</body>
</html>
