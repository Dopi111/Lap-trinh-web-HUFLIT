@model IEnumerable<FiveGuys.Models.MediaImage>

@{
    ViewBag.Title = "Quản Lý Hình Ảnh";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FiveGuys</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-in-out',
                        'slide-up': 'slideUp 0.4s ease-out',
                        'scale-in': 'scaleIn 0.3s ease-out',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { transform: 'translateY(20px)', opacity: '0' },
                            '100%': { transform: 'translateY(0)', opacity: '1' },
                        },
                        scaleIn: {
                            '0%': { transform: 'scale(0.9)', opacity: '0' },
                            '100%': { transform: 'scale(1)', opacity: '1' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .glass-effect {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .hover-lift {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .hover-lift:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 min-h-screen">

    <!-- Header -->
    <div class="bg-white shadow-lg border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl flex items-center justify-center shadow-lg animate-scale-in">
                        <i class="fas fa-images text-white text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
                            Quản Lý Hình Ảnh
                        </h1>
                        <p class="text-sm text-gray-600 mt-1">Quản lý tất cả hình ảnh của hệ thống</p>
                    </div>
                </div>
                <a href="@Url.Action("Create")"
                   class="group flex items-center space-x-2 bg-gradient-to-r from-blue-600 to-indigo-600 text-white px-6 py-3 rounded-xl hover:from-blue-700 hover:to-indigo-700 transform hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl">
                    <i class="fas fa-plus-circle group-hover:rotate-90 transition-transform duration-300"></i>
                    <span class="font-semibold">Thêm Hình Ảnh</span>
                </a>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- Success/Error Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 animate-slide-up">
                <div class="bg-green-50 border-l-4 border-green-500 rounded-lg p-4 shadow-md">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle text-green-500 text-xl mr-3"></i>
                        <p class="text-green-800 font-medium">@TempData["SuccessMessage"]</p>
                    </div>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 animate-slide-up">
                <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 shadow-md">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-circle text-red-500 text-xl mr-3"></i>
                        <p class="text-red-800 font-medium">@TempData["ErrorMessage"]</p>
                    </div>
                </div>
            </div>
        }

        <!-- Filter Section -->
        <div class="glass-effect rounded-2xl shadow-xl p-6 mb-6 animate-slide-up">
            <form method="get" class="flex flex-wrap items-center gap-4">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-filter mr-2 text-blue-500"></i>Lọc theo loại
                    </label>
                    <select name="imageType"
                            onchange="this.form.submit()"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-300 bg-white">
                        <option value="">Tất cả loại hình</option>
                        @if (ViewBag.ImageTypes != null)
                        {
                            foreach (var type in ViewBag.ImageTypes)
                            {
                                <option value="@type" @(Request.QueryString["imageType"] == type ? "selected" : "")>
                                    @type
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="text-sm text-gray-600 bg-blue-50 px-4 py-3 rounded-xl border border-blue-200">
                    <i class="fas fa-info-circle text-blue-500 mr-2"></i>
                    Tổng: <strong class="text-blue-700">@(Model?.Count() ?? 0)</strong> hình ảnh
                </div>
            </form>
        </div>

        <!-- Images Grid -->
        @if (Model != null && Model.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var item in Model)
                {
                    <div class="glass-effect rounded-2xl overflow-hidden shadow-lg hover-lift group animate-fade-in">
                        <!-- Image -->
                        <div class="relative aspect-video bg-gray-100 overflow-hidden">
                            <img src="@item.FullImageUrl"
                                 alt="@item.ImageName"
                                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />

                            <!-- Badge -->
                            <div class="absolute top-3 left-3">
                                <span class="px-3 py-1 bg-gradient-to-r from-blue-500 to-indigo-500 text-white text-xs font-bold rounded-full shadow-lg">
                                    @item.ImageType
                                </span>
                            </div>

                            <!-- Status Badge -->
                            <div class="absolute top-3 right-3">
                                @if (item.IsActive)
                                {
                                    <span class="px-3 py-1 bg-green-500 text-white text-xs font-bold rounded-full shadow-lg animate-pulse">
                                        <i class="fas fa-circle text-[8px] mr-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 bg-gray-400 text-white text-xs font-bold rounded-full shadow-lg">
                                        <i class="fas fa-pause text-[8px] mr-1"></i>Inactive
                                    </span>
                                }
                            </div>

                            <!-- Overlay on Hover -->
                            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                <div class="absolute bottom-3 left-3 right-3">
                                    <div class="flex items-center space-x-2 text-white text-xs">
                                        @if (item.FileSize.HasValue)
                                        {
                                            <span class="bg-white/20 backdrop-blur-sm px-2 py-1 rounded-lg">
                                                <i class="fas fa-file mr-1"></i>@((item.FileSize / 1024).ToString("N0")) KB
                                            </span>
                                        }
                                        @if (item.Width.HasValue && item.Height.HasValue)
                                        {
                                            <span class="bg-white/20 backdrop-blur-sm px-2 py-1 rounded-lg">
                                                <i class="fas fa-expand mr-1"></i>@item.Width × @item.Height
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="p-5">
                            <h3 class="font-bold text-gray-800 text-lg mb-2 truncate group-hover:text-blue-600 transition-colors">
                                @item.ImageName
                            </h3>

                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p class="text-sm text-gray-600 mb-4 line-clamp-2">@item.Description</p>
                            }

                            <div class="flex items-center justify-between text-xs text-gray-500 mb-4 pb-4 border-b border-gray-200">
                                <div class="flex items-center">
                                    <i class="far fa-calendar mr-1.5 text-blue-500"></i>
                                    <span>@item.CreatedDate.ToString("dd/MM/yyyy")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(item.CreatedBy))
                                {
                                    <div class="flex items-center">
                                        <i class="far fa-user mr-1.5 text-indigo-500"></i>
                                        <span>@item.CreatedBy</span>
                                    </div>
                                }
                            </div>

                            <!-- Action Buttons -->
                            <div class="flex items-center gap-2">
                                <a href="@Url.Action("Details", new { id = item.Id })"
                                   class="flex-1 flex items-center justify-center space-x-2 bg-blue-50 hover:bg-blue-100 text-blue-600 px-4 py-2.5 rounded-xl transition-all duration-300 group/btn">
                                    <i class="fas fa-eye group-hover/btn:scale-110 transition-transform"></i>
                                    <span class="text-sm font-medium">Chi tiết</span>
                                </a>
                                <a href="@Url.Action("Edit", new { id = item.Id })"
                                   class="flex items-center justify-center bg-amber-50 hover:bg-amber-100 text-amber-600 px-4 py-2.5 rounded-xl transition-all duration-300 group/btn">
                                    <i class="fas fa-edit group-hover/btn:rotate-12 transition-transform"></i>
                                </a>
                                <a href="@Url.Action("Delete", new { id = item.Id })"
                                   class="flex items-center justify-center bg-red-50 hover:bg-red-100 text-red-600 px-4 py-2.5 rounded-xl transition-all duration-300 group/btn">
                                    <i class="fas fa-trash group-hover/btn:scale-110 transition-transform"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="glass-effect rounded-2xl shadow-xl p-16 text-center animate-scale-in">
                <div class="w-32 h-32 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-image text-6xl text-blue-400"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-3">Chưa có hình ảnh nào</h3>
                <p class="text-gray-600 mb-8 max-w-md mx-auto">
                    Bắt đầu bằng cách thêm hình ảnh đầu tiên của bạn vào hệ thống
                </p>
                <a href="@Url.Action("Create")"
                   class="inline-flex items-center space-x-2 bg-gradient-to-r from-blue-600 to-indigo-600 text-white px-8 py-4 rounded-xl hover:from-blue-700 hover:to-indigo-700 transform hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl">
                    <i class="fas fa-plus-circle text-xl"></i>
                    <span class="font-semibold text-lg">Thêm hình ảnh đầu tiên</span>
                </a>
            </div>
        }

    </div>

    <!-- Footer -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center text-sm text-gray-500">
        <p>FiveGuys Image Management System © 2025</p>
    </div>

</body>
</html>
