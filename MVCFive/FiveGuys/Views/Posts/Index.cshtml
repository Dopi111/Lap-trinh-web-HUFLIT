@model IEnumerable<FiveGuys.Models.Post>

@{
    ViewBag.Title = "Quản Lý Bài Viết";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FiveGuys</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        .glass-effect { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); }
        .hover-lift:hover { transform: translateY(-4px); transition: all 0.3s; }
    </style>
</head>
<body class="bg-gradient-to-br from-green-50 via-emerald-50 to-teal-50 min-h-screen">

    <div class="bg-white shadow-lg border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg">
                        <i class="fas fa-newspaper text-white text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold bg-gradient-to-r from-green-600 to-emerald-600 bg-clip-text text-transparent">
                            Quản Lý Bài Viết
                        </h1>
                        <p class="text-sm text-gray-600 mt-1">Quản lý tin tức và bài viết blog</p>
                    </div>
                </div>
                <a href="@Url.Action("Create")"
                   class="group flex items-center space-x-2 bg-gradient-to-r from-green-600 to-emerald-600 text-white px-6 py-3 rounded-xl hover:from-green-700 hover:to-emerald-700 transform hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl">
                    <i class="fas fa-plus-circle group-hover:rotate-90 transition-transform duration-300"></i>
                    <span class="font-semibold">Viết Bài Mới</span>
                </a>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6">
                <div class="bg-green-50 border-l-4 border-green-500 rounded-lg p-4 shadow-md">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle text-green-500 text-xl mr-3"></i>
                        <p class="text-green-800 font-medium">@TempData["SuccessMessage"]</p>
                    </div>
                </div>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var item in Model)
                {
                    <div class="glass-effect rounded-2xl overflow-hidden shadow-lg hover-lift group">
                        <!-- Featured Image -->
                        @if (!string.IsNullOrEmpty(item.ThumbnailImage))
                        {
                            <div class="relative aspect-video bg-gray-100 overflow-hidden">
                                <img src="@item.ThumbnailImage" alt="@item.Title" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                <div class="absolute top-3 right-3">
                                    @if (item.IsActive)
                                    {
                                        <span class="px-3 py-1 bg-green-500 text-white text-xs font-bold rounded-full shadow-lg">
                                            <i class="fas fa-check text-[8px] mr-1"></i>Published
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1 bg-gray-400 text-white text-xs font-bold rounded-full shadow-lg">
                                            <i class="fas fa-file text-[8px] mr-1"></i>Draft
                                        </span>
                                    }
                                </div>
                                @if (item.IsFeatured)
                                {
                                    <div class="absolute top-3 left-3">
                                        <span class="px-3 py-1 bg-gradient-to-r from-yellow-500 to-orange-500 text-white text-xs font-bold rounded-full shadow-lg animate-pulse">
                                            <i class="fas fa-star text-[8px] mr-1"></i>Nổi bật
                                        </span>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Content -->
                        <div class="p-5">
                            <div class="flex items-center justify-between mb-3">
                                @if (item.Category != null)
                                {
                                    <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded-lg">
                                        @item.Category.TenLoai
                                    </span>
                                }
                                <span class="text-xs text-gray-500 flex items-center">
                                    <i class="far fa-eye mr-1"></i> @item.ViewCount
                                </span>
                            </div>

                            <h3 class="font-bold text-gray-800 text-lg mb-2 line-clamp-2 group-hover:text-green-600 transition-colors">
                                @item.Title
                            </h3>

                            @if (!string.IsNullOrEmpty(item.ShortDescription))
                            {
                                <p class="text-sm text-gray-600 mb-4 line-clamp-3">@item.ShortDescription</p>
                            }

                            <div class="flex items-center justify-between text-xs text-gray-500 mb-4 pb-4 border-b border-gray-200">
                                <div class="flex items-center">
                                    <i class="far fa-calendar mr-1.5 text-green-500"></i>
                                    <span>@item.PublishedDate.ToString("dd/MM/yyyy")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(item.Author))
                                {
                                    <div class="flex items-center">
                                        <i class="far fa-user mr-1.5 text-emerald-500"></i>
                                        <span>@item.Author</span>
                                    </div>
                                }
                            </div>

                            <!-- Action Buttons -->
                            <div class="flex items-center gap-2">
                                <a href="@Url.Action("Details", new { id = item.Id })"
                                   class="flex-1 flex items-center justify-center space-x-2 bg-green-50 hover:bg-green-100 text-green-600 px-4 py-2.5 rounded-xl transition-all duration-300 group/btn">
                                    <i class="fas fa-eye group-hover/btn:scale-110 transition-transform"></i>
                                    <span class="text-sm font-medium">Xem</span>
                                </a>
                                <a href="@Url.Action("Edit", new { id = item.Id })"
                                   class="flex items-center justify-center bg-amber-50 hover:bg-amber-100 text-amber-600 px-4 py-2.5 rounded-xl transition-all duration-300 group/btn">
                                    <i class="fas fa-edit group-hover/btn:rotate-12 transition-transform"></i>
                                </a>
                                <a href="@Url.Action("Delete", new { id = item.Id })"
                                   class="flex items-center justify-center bg-red-50 hover:bg-red-100 text-red-600 px-4 py-2.5 rounded-xl transition-all duration-300 group/btn">
                                    <i class="fas fa-trash group-hover/btn:scale-110 transition-transform"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="glass-effect rounded-2xl shadow-xl p-16 text-center">
                <div class="w-32 h-32 bg-gradient-to-br from-green-100 to-emerald-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-newspaper text-6xl text-green-400"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-3">Chưa có bài viết nào</h3>
                <p class="text-gray-600 mb-8 max-w-md mx-auto">
                    Bắt đầu chia sẻ câu chuyện của bạn với bài viết đầu tiên
                </p>
                <a href="@Url.Action("Create")"
                   class="inline-flex items-center space-x-2 bg-gradient-to-r from-green-600 to-emerald-600 text-white px-8 py-4 rounded-xl hover:from-green-700 hover:to-emerald-700 transform hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl">
                    <i class="fas fa-pen text-xl"></i>
                    <span class="font-semibold text-lg">Viết bài đầu tiên</span>
                </a>
            </div>
        }

    </div>

</body>
</html>
