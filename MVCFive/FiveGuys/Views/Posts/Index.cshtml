@model IEnumerable<FiveGuys.Models.Post>

@{
    ViewBag.Title = "Quản Lý Bài Viết";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto|Varela+Round">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <style>
        body { margin-top: 20px; }
        .table-wrapper { background: #fff; padding: 20px 25px; border-radius: 3px; box-shadow: 0 1px 1px rgba(0,0,0,.05); }
        .table-title { background: #435d7d; color: #fff; padding: 16px 30px; margin: -20px -25px 10px; border-radius: 3px 3px 0 0; }
        .table-title h2 { margin: 5px 0 0; font-size: 24px; }
        .table-title .btn { color: #fff; float: right; font-size: 13px; border: none; min-width: 50px; margin-left: 10px; }
        .post-thumb { max-width: 80px; max-height: 60px; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="table-wrapper">
            <div class="table-title">
                <div class="row">
                    <div class="col-sm-6">
                        <h2>Quản Lý <b>Bài Viết</b></h2>
                    </div>
                    <div class="col-sm-6">
                        <a href="@Url.Action("Create")" class="btn btn-success">
                            <i class="fa fa-plus"></i> <span>Thêm Bài Viết Mới</span>
                        </a>
                    </div>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["SuccessMessage"]
                </div>
            }

            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Hình</th>
                        <th>Tiêu đề</th>
                        <th>Danh mục</th>
                        <th>Tác giả</th>
                        <th>Lượt xem</th>
                        <th>Trạng thái</th>
                        <th>Ngày xuất bản</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ThumbnailImage))
                                    {
                                        <img src="@item.ThumbnailImage" alt="@item.Title" class="post-thumb img-thumbnail" />
                                    }
                                </td>
                                <td>
                                    <strong>@item.Title</strong><br />
                                    <small class="text-muted">
                                        Slug: @item.Slug
                                        @if (item.IsFeatured)
                                        {
                                            <span class="label label-warning">Nổi bật</span>
                                        }
                                    </small>
                                </td>
                                <td>@item.Category?.TenLoai</td>
                                <td>@item.Author</td>
                                <td>
                                    <span class="badge">@item.ViewCount</span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="label label-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="label label-default">Nháp</span>
                                    }
                                </td>
                                <td>@item.PublishedDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-info btn-xs" title="Xem">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning btn-xs" title="Sửa">
                                        <i class="fa fa-pencil"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger btn-xs" title="Xóa">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center">
                                <p class="text-muted">Chưa có bài viết nào.</p>
                                <a href="@Url.Action("Create")" class="btn btn-primary">Thêm bài viết đầu tiên</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="clearfix">
                <div class="hint-text">
                    Hiển thị <b>@(Model?.Count() ?? 0)</b> bài viết
                </div>
            </div>
        </div>
    </div>
</body>
</html>
